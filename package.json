{
  "name": "smartcommit",
  "version": "2.6.3",
  "description": "AI-powered git commit message generator using OpenRouter API with multiple AI models (Claude, GPT-4, Gemini, Llama)",
  "main": "src/index.js",
  "bin": {
    "smartc": "./bin/smartc.exe"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "build": "node scripts/build-all.js",
    "build:local": "node scripts/build-local-if-needed.js && node scripts/install-platform-bin.js",
    "prepare": "node scripts/build-local-if-needed.js && node scripts/install-platform-bin.js",
    "preinstall": "node scripts/install-platform-bin.js --skip-if-missing",
    "postinstall": "node scripts/install-platform-bin.js --skip-if-missing",
    "prepublishOnly": "node scripts/build-all.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "echo \"No linter configured yet\"",
    "clean": "node scripts/clean.js"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "openrouter",
    "claude",
    "gpt-4",
    "gemini",
    "llama",
    "qwen",
    "conventional-commits",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "clipboardy": "^3.0.0",
    "commander": "^14.0.0",
    "inquirer": "^8.2.6",
    "simple-git": "^3.28.0"
  }
}
