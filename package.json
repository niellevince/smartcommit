{
  "name": "smartcommit",
  "version": "2.7.0",
  "description": "AI-powered git commit message generator using OpenRouter API with multiple AI models (Claude, GPT-4, Gemini, Llama)",
  "main": "src/index.js",
  "bin": {
    "smartc": "./src/cli.js"
  },
  "scripts": {
    "start": "bun src/cli.js",
    "build": "bun scripts/build-all.js",
    "build:local": "bun scripts/build-local-if-needed.js && bun scripts/install-platform-bin.js",
    "link": "bun link",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "echo \"No linter configured yet\"",
    "clean": "bun scripts/clean.js"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "openrouter",
    "claude",
    "gpt-4",
    "gemini",
    "llama",
    "qwen",
    "conventional-commits",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "clipboardy": "^3.0.0",
    "commander": "^14.0.0",
    "inquirer": "^8.2.6",
    "simple-git": "^3.28.0"
  }
}
